# Environment and secrets
.env
.env.*
*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.coverage*

# Node/JS
node_modules/
**/node_modules/

# OS/editor
.DS_Store
.idea/
.vscode/
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
build/
dist/

# Frontend build cache
/src/frontend/.next/
/src/frontend/out/
/src/frontend/.turbo/
/src/frontend/.vercel/
/src/frontend-svelte-backup/.svelte-kit/
/src/frontend-svelte-backup/build/

# Local data & backups (do not commit local DBs)
/data/*.db
/data/backups/
/data/telegram_sessions/
backups/
*.sqlite
*.db

# Tooling metadata (keep repo config directories, ignore their caches if any)
/.clinerules
/.cursor
/.roo
/.taskmaster
/.trae
/.windsurf

# Project-specific keepers (ensure we do NOT ignore source files)
# Do not ignore these source/docs files:
!AGENTS.md
!CLAUDE.md
!src/core/processor.py

# Git
.gitattributes
